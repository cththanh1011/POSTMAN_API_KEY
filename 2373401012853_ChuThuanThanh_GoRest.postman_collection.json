      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\r\npm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nif (pm.response.code === 201) {\r\n    const jsonData = pm.response.json();\r\n\r\n    pm.environment.set(\"userid\", jsonData.id);\r\n\r\n    pm.test(\"User ID is returned and saved\", function () {\r\n        pm.expect(jsonData.id).to.exist;\r\n        pm.expect(pm.environment.get(\"userid\")).to.eql(\r\n            String(jsonData.id)\r\n        );\r\n    });\r\n\r\n    pm.test(\"User name is correct\", function () {\r\n        pm.expect(jsonData.name).to.eql(\r\n            pm.environment.get(\"name\")\r\n        );\r\n    });\r\n\r\n    pm.test(\"User gender is correct\", function () {\r\n        pm.expect(jsonData.gender).to.eql(\r\n            pm.environment.get(\"gender\")\r\n        );\r\n    });\r\n\r\n    pm.test(\"User status is active\", function () {\r\n        pm.expect(jsonData.status).to.eql(\"active\");\r\n    });\r\n}\r\n"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"{{name}}\",\r\n  \"gender\": \"{{gender}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"status\": \"{{status}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseurl}}/users",
              "host": [
                "{{baseurl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        },
